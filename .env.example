NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Opsional: garam untuk hash IP pembatas feedback
FEEDBACK_SALT=

# Alamat situs (WAJIB di produksi): dipakai untuk tautan di email dan redirect login. Contoh: https://indiego.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (SMTP): dipakai untuk semua email autentikasi lewat Auth Hook "Send Email"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Rahasia hook dari Supabase (Auth > Hooks > Send Email > Generate secret)
SEND_EMAIL_HOOK_SECRET=
# Opsional: pengirim bawaan sebelum diatur di Admin > Sistem > Email
MAIL_FROM_EMAIL=
